{
  "name": "astrama",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter @astrama/api db:generate && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages --ext .ts,.tsx",
    "test": "pnpm -r --if-present test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "dev": "pnpm --filter @astrama/contracts build && pnpm --filter @astrama/domain build && pnpm --parallel --filter @astrama/api --filter @astrama/web dev",
    "db:migrate": "pnpm --filter @astrama/api db:migrate",
    "db:bootstrap": "pnpm --filter @astrama/api db:bootstrap",
    "db:seed": "pnpm --filter @astrama/api db:seed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "jsqr": "^1.4.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "3.2.7"
  }
}
