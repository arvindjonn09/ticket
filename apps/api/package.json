{
  "name": "@astrama/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:bootstrap": "tsx src/database-bootstrap.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "@astrama/contracts": "workspace:*",
    "@astrama/domain": "workspace:*",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.8",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-fastify": "11.2.9",
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "fastify": "^5.6.2",
    "nodemailer": "^10.5.0",
    "pg-boss": "^12.38.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
