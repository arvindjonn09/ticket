{
	auto_https disable_redirects
}

https://astrama.test, https://*.astrama.test {
	tls internal
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}
	handle /api/internal/tls-allowed {
		respond 404
	}
	handle /api/* {
		reverse_proxy api:4311
	}
	@public host astrama.test
	@operator host ops.astrama.test
	handle @operator {
		root * /operator
		try_files {path} /index.html
		file_server
	}
	handle @public {
		root * /public
		try_files {path} /index.html
		file_server
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
