# Copy to .env.production on the deployment host; never commit the populated file.
# Database passwords must be URL-safe, independently generated, and at least 16 characters.
APP_DOMAIN=change-me
PLATFORM_MODE=single
APP_BASE_DOMAIN=change-me.example
PUBLIC_SITE_ORIGIN=https://change-me.example
PUBLIC_SITE_HOST=change-me.example
OPERATOR_ORIGIN=https://ops.change-me.example
OPERATOR_SITE_HOST=ops.change-me.example
OPERATOR_IP_ALLOWLIST=
DEFAULT_TRIAL_SEAT_LIMIT=25
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CAPTCHA_HMAC_SECRET=
DISPOSABLE_EMAIL_DOMAINS=
APP_ORIGIN=https://change-me.example
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MFA_ENCRYPTION_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=change-me
OPERATOR_ALERT_EMAIL=change-me
RELEASE_TAG=local
# Hosted allowances: owner must set positive integers before production startup.
TENANT_REQUESTS_PER_MINUTE=
TENANT_UPLOAD_BYTES_PER_DAY=
TENANT_INBOUND_PER_HOUR=
TENANT_EXPORTS_PER_DAY=
# Optional: enable only AFTER private Uptime Kuma setup; keep both blank until then.
STATUS_PAGE_ORIGIN=
STATUS_SITE_HOST=
