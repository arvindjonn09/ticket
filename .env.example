# LOCAL DEMONSTRATION ONLY. Export these values in your shell for native dev/tests.
DATABASE_URL=postgresql://astrama_app:astrama-local-app@localhost:5439/astrama
MIGRATION_DATABASE_URL=postgresql://astrama_owner:astrama-local-owner@localhost:5439/astrama
APP_DB_PASSWORD=astrama-local-app
DEMO_PASSWORD=Astrama-demo-2026!
NODE_ENV=development
APP_ORIGIN=http://localhost:4310
PORT=4311
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this stable and private; changing it prevents decryption of enrolled MFA secrets.
MFA_ENCRYPTION_KEY=
# Local attachment and mail services (SMTP host port is only for native tests).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=astrama-attachments
S3_ACCESS_KEY=astrama-local
S3_SECRET_KEY=astrama-local-storage-password
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_FROM=desk@astrama.test
MAILPIT_URL=http://localhost:4312
