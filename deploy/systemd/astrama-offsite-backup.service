[Unit]
Description=Astrama Restic offsite backup and isolated restore verification
OnFailure=astrama-backup-alert.service

[Service]
Type=oneshot
User=astrama
Group=astrama
SupplementaryGroups=docker
WorkingDirectory=/opt/astrama
EnvironmentFile=/etc/astrama/backup.env
UMask=0077
TimeoutStartSec=4h
ExecStart=/usr/bin/node /opt/astrama/scripts/offsite-backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/astrama/.local-backups
