# LOCAL DEMONSTRATION ONLY. Export these values in your shell for native dev/tests.
# Full hosted UI sandbox: docker compose -f compose.hosted-local.yaml up --build -d
# See docs/local-testing.md. Its hosted origins/provider are set by that Compose file.
DATABASE_URL=postgresql://astrama_app:astrama-local-app@localhost:5439/astrama
MIGRATION_DATABASE_URL=postgresql://astrama_owner:astrama-local-owner@localhost:5439/astrama
APP_DB_PASSWORD=astrama-local-app
DEMO_PASSWORD=Astrama-demo-2026!
NODE_ENV=development
APP_ORIGIN=http://localhost:4310
PLATFORM_MODE=single
APP_BASE_DOMAIN=astrama.test
PUBLIC_SITE_ORIGIN=https://astrama.test
OPERATOR_ORIGIN=https://ops.astrama.test
DEFAULT_TRIAL_SEAT_LIMIT=25
PAYMENT_PROVIDER=test
TEST_PAYMENT_WEBHOOK_SECRET=ci-payment-secret
CAPTCHA_MODE=test
# Replace with a private random 32-byte hex value to enable non-test CAPTCHA.
CAPTCHA_HMAC_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DISPOSABLE_EMAIL_DOMAINS=
PORT=4311
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this stable and private; changing it prevents decryption of enrolled MFA secrets.
MFA_ENCRYPTION_KEY=
# Local attachment and mail services (SMTP host port is only for native tests).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=astrama-attachments
S3_ACCESS_KEY=astrama-local
S3_SECRET_KEY=astrama-local-storage-password
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_FROM=desk@astrama.test
# Optional sender-domain override; otherwise derived from SMTP_FROM.
PLATFORM_MAIL_DOMAIN=
# Hosted mode can derive in.<APP_BASE_DOMAIN>.
INBOUND_MAIL_DOMAIN=
# Optional Microsoft 365 delegated SMTP connection. Register an Entra Web app first.
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Optional secret-file path inside the API/worker containers; mount it read-only separately.
M365_CLIENT_SECRET_FILE=
M365_REDIRECT_URI=
MAILPIT_URL=http://localhost:4312
