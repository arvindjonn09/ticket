[Unit]
Description=Alert the Astrama operator after a failed backup job

[Service]
Type=oneshot
User=astrama
Group=astrama
SupplementaryGroups=docker
WorkingDirectory=/opt/astrama
EnvironmentFile=/etc/astrama/backup.env
UMask=0077
ExecStart=/usr/bin/node /opt/astrama/scripts/production-watch.mjs --backup-failed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
